<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sport Plus Admin</title>

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                "primary": "#006418",
                "primary-container": "#267e2e",
                "surface": "#f1f5f9",
                "on-surface": "#0f172a",
                "error": "#ba1a1a"
              },
              fontFamily: {
                "manrope": ["Manrope", "sans-serif"],
                "inter": ["Inter", "sans-serif"]
              }
            }
          }
        }
    </script>

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        aside {
            border-right: 2px solid #cbd5e1 !important;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #006418 0%, #267e2e 100%) !important;
        }

        #userDropdownMenu {
            animation: fadeIn 0.15s ease-out;
        }
        /* Đã sửa lỗi @@keyframes cho bạn ở đây */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body class="bg-surface font-inter text-on-surface min-h-screen flex flex-col">

    <aside class="fixed left-0 top-0 h-screen w-64 bg-white z-40 flex flex-col overflow-hidden">
        <div class="px-6 py-8">
            <h1 class="text-2xl font-black text-primary uppercase tracking-tighter font-manrope">Sport Plus</h1>
            <p class="text-[10px] font-bold text-zinc-400 mt-1 uppercase tracking-widest opacity-70">Admin Portal</p>
        </div>

        <nav class="flex-1 px-4 space-y-1 overflow-y-auto">
            @{
                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            }

            @* 1. Tổng quan *@
            <a href="@Url.Action("Index", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Index" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="font-medium">Tổng quan</span>
            </a>

            @* 2. Khách hàng *@
            <a href="@Url.Action("Customers", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Customers" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">group</span>
                <span class="font-medium">Khách hàng</span>
            </a>

            @* 3. Dịch vụ *@
            <a href="@Url.Action("Services", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Services" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">sports_soccer</span>
                <span class="font-medium">Dịch vụ</span>
            </a>

            @* 4. Báo cáo *@
            <a href="@Url.Action("Reports", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Reports" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">analytics</span>
                <span class="font-medium">Báo cáo</span>
            </a>

            @* 5. Kho hàng *@
            <a href="@Url.Action("Inventory", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Inventory" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">inventory_2</span>
                <span class="font-medium">Kho hàng</span>
            </a>

            @* 6. Nhà cung cấp *@
            <a href="@Url.Action("Suppliers", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Suppliers" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">handshake</span>
                <span class="font-medium">Nhà cung cấp</span>
            </a>

            @* 7. Nhân sự *@
            <a href="@Url.Action("Staff", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Staff" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">badge</span>
                <span class="font-medium">Nhân sự</span>
            </a>

            @* 8. Quản lý sân *@
            <a href="@Url.Action("Fields", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Fields" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">stadium</span>
                <span class="font-medium">Quản lý sân</span>
            </a>

            @* 9. Đặt sân *@
            <a href="@Url.Action("Booking", "Admin")" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all @(currentAction == "Booking" ? "text-primary font-bold bg-emerald-50 border-r-4 border-primary" : "text-zinc-500 hover:bg-zinc-100")">
                <span class="material-symbols-outlined">calendar_month</span>
                <span class="font-medium">Đặt sân</span>
            </a>
        </nav>

        <div class="p-4 mt-auto">
            <button class="w-full flex items-center justify-center gap-2 py-4 rounded-xl hero-gradient text-white font-bold shadow-lg">
                <span class="material-symbols-outlined">add_circle</span>
                <span>Đặt sân mới</span>
            </button>
        </div>
    </aside>

    <main class="ml-64 min-h-screen flex flex-col">
        <header class="sticky top-0 px-8 py-4 bg-white/90 backdrop-blur-md z-30 flex justify-between items-center shadow-sm border-b border-zinc-200">
            <div class="flex-1 max-w-md relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400">search</span>
                <input class="w-full bg-zinc-100 border-none rounded-full pl-10 pr-4 py-2.5 text-sm focus:ring-2 focus:ring-primary/20 transition-all font-medium" placeholder="Tìm kiếm..." />
            </div>

            <div class="flex items-center gap-6">
                <button class="text-zinc-400 hover:text-primary transition-colors relative">
                    <span class="material-symbols-outlined">notifications</span>
                    <span class="absolute top-0 right-0 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                </button>

                <div class="relative inline-block text-left">
                    <button type="button" id="userMenuTrigger" class="flex items-center gap-3 pl-6 border-l border-zinc-200 hover:bg-zinc-50 p-1.5 rounded-2xl transition-all active:scale-95">
                        <div class="text-right hidden sm:block">
                            <p class="text-sm font-bold text-on-surface leading-none">Admin User</p>
                            <p class="text-[10px] text-zinc-400 uppercase font-bold tracking-widest mt-1">Quản trị viên</p>
                        </div>
                        <div class="w-10 h-10 rounded-full hero-gradient p-0.5 shadow-md flex items-center justify-center text-white font-black text-xs">
                            AD
                        </div>
                    </button>

                    <div id="userDropdownMenu" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-2xl border border-zinc-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-zinc-50 mb-1">
                            <p class="text-xs text-zinc-400 font-bold uppercase tracking-widest">Tài khoản</p>
                            <p class="text-sm font-medium text-zinc-800">admin@sportplus.vn</p>
                        </div>
                        <a href="#" class="flex items-center gap-3 px-4 py-2.5 text-sm text-zinc-600 hover:bg-zinc-50 hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">account_circle</span>
                            Thông tin cá nhân
                        </a>
                        <hr class="my-1 border-zinc-50">
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 text-sm text-red-600 hover:bg-red-50 transition-colors font-bold">
                                <span class="material-symbols-outlined text-[20px]">logout</span>
                                Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </header>

        <div class="flex-1 p-0">
            @RenderBody()
        </div>

        <footer class="p-8 border-t border-zinc-200 text-[10px] text-zinc-400 uppercase tracking-widest flex justify-between bg-white/50">
            <p>© 2026 Sport Plus - Hệ thống Quản lý Sân bóng.</p>
            <div class="flex gap-2 items-center">
                <span class="text-primary font-bold">System Online</span>
                <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            </div>
        </footer>
    </main>

    <script src="~/js/admin-layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>