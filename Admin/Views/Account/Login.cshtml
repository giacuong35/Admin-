@model Admin.ViewModels.Auth.LoginVm

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng nhập - Sport Plus Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>
    <div class="login-page">
        <section class="login-visual">
            <div class="stadium-light"></div>
            <div class="stadium-light light-two"></div>
            <div class="net-lines"></div>

            <div class="brand">
                <div class="brand-logo">
                    <span class="material-symbols-rounded">sports_soccer</span>
                </div>
                <div>
                    <h1>SPORT PLUS</h1>
                    <p>ADMIN PORTAL</p>
                </div>
            </div>

            <div class="hero-content">
                <h2>
                    Quản lý dễ dàng<br />
                    Vận hành <span>hiệu quả</span>
                </h2>

                <p>
                    Nền tảng quản trị toàn diện cho hệ thống sân bóng,
                    giúp bạn theo dõi, quản lý và phát triển kinh doanh hiệu quả.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-rounded">monitoring</span>
                        </div>
                        <div>
                            <h4>Thống kê trực quan</h4>
                            <p>Doanh thu, lượt đặt sân, khách hàng</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-rounded">calendar_month</span>
                        </div>
                        <div>
                            <h4>Quản lý linh hoạt</h4>
                            <p>Đặt sân, dịch vụ, nhân sự, kho hàng</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <span class="material-symbols-rounded">shield</span>
                        </div>
                        <div>
                            <h4>Bảo mật an toàn</h4>
                            <p>Phân quyền Admin và Staff rõ ràng</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="real-ball">
                <div class="ball-shadow"></div>
                <div class="ball-inner">
                    <span class="material-symbols-rounded">sports_soccer</span>
                </div>
                <div class="energy-ring ring-one"></div>
                <div class="energy-ring ring-two"></div>
            </div>

            <div class="grass"></div>

            <span class="particle p1"></span>
            <span class="particle p2"></span>
            <span class="particle p3"></span>
            <span class="particle p4"></span>
            <span class="particle p5"></span>

            <div class="copyright">© 2026 Sport Plus. All rights reserved.</div>
        </section>

        <section class="login-panel">
            <div class="dots"></div>
            <div class="green-curve"></div>

            <div class="login-card">
                <div class="card-logo">
                    <span class="material-symbols-rounded">sports_soccer</span>
                </div>

                <div class="login-header">
                    <h3>Chào mừng trở lại!</h3>
                    <p>Vui lòng đăng nhập để tiếp tục vào trang quản trị</p>
                </div>

                <form asp-action="Login" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="Email">Email</label>
                        <div class="input-box">
                            <span class="material-symbols-rounded">mail</span>
                            <input asp-for="Email" placeholder="Nhập email của bạn" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Mật khẩu</label>
                        <div class="input-box">
                            <span class="material-symbols-rounded">lock</span>
                            <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="field-validation"></span>
                    </div>

                    <button type="submit" class="login-btn">
                        <span>Đăng nhập</span>
                        <span class="material-symbols-rounded">arrow_forward</span>
                    </button>
                </form>

                <div class="login-note">
                    <span class="material-symbols-rounded">lock</span>
                    Chỉ tài khoản Admin hoặc Staff mới được truy cập trang quản trị.
                </div>
            </div>
        </section>
    </div>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>