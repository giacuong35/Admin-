@{
    ViewData["Title"] = "Tổng quan Dashboard";
}

@* Phần Content Canvas lấy từ code_2.html *@
<div class="p-8 space-y-8 flex-1">
    <!-- Hero Stats Grid: Hiển thị các chỉ số quan trọng -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        @* Doanh thu hôm nay *@
        <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border-l-4 border-primary group hover:bg-primary transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
                <span class="material-symbols-outlined text-primary group-hover:text-white">payments</span>
                <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">+12%</span>
            </div>
            <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest group-hover:text-emerald-100">Doanh thu hôm nay</p>
            <h3 class="text-2xl font-black font-manrope mt-1 group-hover:text-white">12.450k VND</h3>
        </div>

        @* Số lượng đặt sân *@
        <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border-l-4 border-tertiary group hover:bg-tertiary transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
                <span class="material-symbols-outlined text-tertiary group-hover:text-white">calendar_today</span>
                <span class="text-[10px] font-bold text-tertiary bg-tertiary-fixed px-2 py-1 rounded-full">+5</span>
            </div>
            <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest group-hover:text-tertiary-fixed">Số lượng đặt sân</p>
            <h3 class="text-2xl font-black font-manrope mt-1 group-hover:text-white">48</h3>
        </div>

        @* Sân đang hoạt động (Live) *@
        <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border-l-4 border-secondary group hover:bg-secondary transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
                <span class="material-symbols-outlined text-secondary group-hover:text-white">stadium</span>
                <div class="flex items-center gap-1 group-hover:text-white">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-[10px] font-bold">Live</span>
                </div>
            </div>
            <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest group-hover:text-secondary-fixed">Sân đang hoạt động</p>
            <h3 class="text-2xl font-black font-manrope mt-1 group-hover:text-white">12/15</h3>
        </div>

        @* Khách hàng mới *@
        <div class="bg-surface-container-lowest p-6 rounded-xl shadow-sm border-l-4 border-primary-container group hover:bg-primary-container transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
                <span class="material-symbols-outlined text-primary-container group-hover:text-white">person_add</span>
                <span class="text-[10px] font-bold text-primary-container bg-primary-fixed px-2 py-1 rounded-full">+8%</span>
            </div>
            <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-widest group-hover:text-on-primary-container">Khách hàng mới</p>
            <h3 class="text-2xl font-black font-manrope mt-1 group-hover:text-white">24</h3>
        </div>
    </div>

    <!-- Bento Charts Section: Biểu đồ xu hướng và phân bổ -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        @* Biểu đồ doanh thu (SVG/CSS) *@
        <div class="lg:col-span-2 bg-surface-container-lowest p-8 rounded-xl shadow-sm relative overflow-hidden">
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h2 class="text-2xl font-black font-manrope tracking-tight uppercase">Xu hướng doanh thu</h2>
                    <p class="text-sm text-zinc-500 font-medium">Phân tích dòng tiền hàng tháng</p>
                </div>
                <div class="flex gap-2">
                    <button class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest border border-zinc-200 rounded-lg">Tuần</button>
                    <button class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest bg-primary text-white rounded-lg">Tháng</button>
                </div>
            </div>
            <div class="h-64 w-full flex items-end gap-1">
                <div class="flex-1 bg-emerald-100 rounded-t-lg h-[40%]"></div>
                <div class="flex-1 bg-emerald-100 rounded-t-lg h-[55%]"></div>
                <div class="flex-1 bg-emerald-200 rounded-t-lg h-[45%]"></div>
                <div class="flex-1 bg-emerald-300 rounded-t-lg h-[70%]"></div>
                <div class="flex-1 bg-emerald-400 rounded-t-lg h-[85%]"></div>
                <div class="flex-1 bg-primary rounded-t-lg h-[100%]"></div>
                <div class="flex-1 bg-emerald-200 rounded-t-lg h-[60%]"></div>
            </div>
        </div>

        @* Hoạt động đặt sân *@
        <div class="bg-primary text-white p-8 rounded-xl shadow-lg relative overflow-hidden group">
            <h2 class="text-xl font-black font-manrope tracking-tight uppercase mb-2">Hoạt động đặt sân</h2>
            <div class="space-y-6 mt-8">
                <div>
                    <div class="flex justify-between text-xs font-bold uppercase tracking-widest mb-2"><span>Sân Bóng Đá</span><span>75%</span></div>
                    <div class="h-2 bg-emerald-900/30 rounded-full overflow-hidden"><div class="h-full bg-white w-3/4"></div></div>
                </div>
                <div>
                    <div class="flex justify-between text-xs font-bold uppercase tracking-widest mb-2"><span>Sân Tennis</span><span>45%</span></div>
                    <div class="h-2 bg-emerald-900/30 rounded-full overflow-hidden"><div class="h-full bg-emerald-300 w-[45%]"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Table: Danh sách đặt sân gần đây -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-zinc-100">
        <div class="px-8 py-6 flex justify-between items-center border-b border-zinc-50">
            <h2 class="text-xl font-black font-manrope tracking-tight uppercase">Đặt sân gần đây</h2>
        </div>
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low">
                    <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Khách hàng</th>
                    <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Loại sân</th>
                    <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Trạng thái</th>
                    <th class="px-8 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500 text-right">Tổng tiền</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-50">
                <tr class="hover:bg-zinc-50 transition-colors">
                    <td class="px-8 py-4 text-sm font-bold">Nguyễn Văn Linh</td>
                    <td class="px-8 py-4 text-sm font-medium">Sân Bóng Đá 5A</td>
                    <td class="px-8 py-4"><span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold uppercase">Thành công</span></td>
                    <td class="px-8 py-4 text-right text-sm font-bold">450.000đ</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>