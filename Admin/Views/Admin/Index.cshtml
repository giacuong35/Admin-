@model Admin.ViewModels.Dashboard.DashboardPageVm

@{
    ViewData["Title"] = "Tổng quan";
    var summary = Model.Summary ?? new Admin.ViewModels.Dashboard.DashboardSummaryVm();
    var topServices = Model.RevenueByService?.Take(5).ToList() ?? new();
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-3xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Tổng quan hệ thống
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Theo dõi booking, doanh thu, sân hoạt động và các chỉ số quan trọng theo dữ liệu thực tế từ hệ thống.
            </p>
            <a asp-action="Reports"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-full text-sm font-bold shadow-lg">
                <span class="material-symbols-outlined text-[20px]">bar_chart</span>
                <span>Xem báo cáo chi tiết</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6">
        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Booking chờ xử lý</div>
            <div class="text-4xl font-manrope font-extrabold text-primary">@summary.PendingBookings</div>
            <div class="text-sm text-zinc-500 mt-2">Bao gồm các booking chưa xử lý xong</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Chờ đặt cọc</div>
            <div class="text-4xl font-manrope font-extrabold text-amber-600">@summary.PendingDepositBookings</div>
            <div class="text-sm text-zinc-500 mt-2">Các booking đang chờ khách thanh toán cọc</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Doanh thu hôm nay</div>
            <div class="text-4xl font-manrope font-extrabold text-emerald-600">@summary.TodayRevenue.ToString("N0")</div>
            <div class="text-sm text-zinc-500 mt-2">VNĐ</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Booking xác nhận hôm nay</div>
            <div class="text-4xl font-manrope font-extrabold text-sky-600">@summary.TodayConfirmed</div>
            <div class="text-sm text-zinc-500 mt-2">Số booking đã được xác nhận</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Sân đang hoạt động</div>
            <div class="text-4xl font-manrope font-extrabold text-primary">@summary.ActiveFields</div>
            <div class="text-sm text-zinc-500 mt-2">Số sân có thể phục vụ</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Sân bảo trì</div>
            <div class="text-4xl font-manrope font-extrabold text-orange-600">@summary.MaintenanceFields</div>
            <div class="text-sm text-zinc-500 mt-2">Số sân đang ngưng để bảo trì</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Sự cố mới</div>
            <div class="text-4xl font-manrope font-extrabold text-red-600">@summary.NewIncidents</div>
            <div class="text-sm text-zinc-500 mt-2">Cần ưu tiên kiểm tra</div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
            <div class="text-xs font-black uppercase tracking-widest text-zinc-400 mb-2">Khách hàng hoạt động</div>
            <div class="text-4xl font-manrope font-extrabold text-violet-600">@summary.ActiveCustomers</div>
            <div class="text-sm text-zinc-500 mt-2">Khách hàng đang hoạt động trong hệ thống</div>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-100">
                <h3 class="font-manrope font-bold text-xl text-primary">Doanh thu theo tháng (@Model.SelectedYear)</h3>
            </div>

            @if (Model.RevenueByMonth.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[700px]">
                        <thead class="bg-zinc-50 border-b border-zinc-100">
                            <tr>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Tháng</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Số booking</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Doanh thu</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Giá trị TB</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100">
                            @foreach (var item in Model.RevenueByMonth.OrderBy(x => x.Month))
                            {
                                <tr>
                                    <td class="px-6 py-4 font-bold text-zinc-700">Tháng @item.Month</td>
                                    <td class="px-6 py-4 text-zinc-600">@item.TotalBookings</td>
                                    <td class="px-6 py-4 font-bold text-primary">@item.TotalRevenue.ToString("N0") VNĐ</td>
                                    <td class="px-6 py-4 text-zinc-600">@item.AvgBookingValue.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-6 py-12 text-center text-zinc-500">Chưa có dữ liệu doanh thu theo tháng.</div>
            }
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-100">
                <h3 class="font-manrope font-bold text-xl text-primary">Top dịch vụ doanh thu</h3>
            </div>

            @if (topServices.Any())
            {
                <div class="p-6 space-y-4">
                    @foreach (var service in topServices)
                    {
                        <div class="rounded-2xl border border-zinc-100 p-4">
                            <div class="font-bold text-zinc-700">@service.ServiceName</div>
                            <div class="text-sm text-zinc-500 mt-1">SL bán: @service.TotalQuantitySold | Booking: @service.TotalBookings</div>
                            <div class="text-lg font-extrabold text-primary mt-2">@service.TotalRevenue.ToString("N0") VNĐ</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="px-6 py-12 text-center text-zinc-500">Chưa có dữ liệu doanh thu dịch vụ.</div>
            }
        </div>
    </div>
</div>