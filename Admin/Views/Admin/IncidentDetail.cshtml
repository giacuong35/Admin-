@model Admin.ViewModels.Incidents.IncidentDetailVm

@{
    ViewData["Title"] = "Chi tiết sự cố";
}

<div class="p-8 space-y-6">
    <div class="rounded-3xl hero-gradient text-white p-8">
        <h1 class="text-4xl font-black">CHI TIẾT SỰ CỐ</h1>
        <p class="mt-3 text-white/90">Thông tin chi tiết về sự cố phát sinh.</p>
    </div>

    <div class="flex items-center gap-3">
        <a asp-action="Incidents" class="inline-flex items-center gap-2 rounded-2xl border border-zinc-300 px-5 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-100">
            Quay lại danh sách
        </a>

        <a asp-action="HandleIncident" asp-route-id="@Model.IncidentId"
           class="inline-flex items-center gap-2 rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-700">
            Xử lý sự cố
        </a>
    </div>

    <div class="bg-white rounded-3xl border border-zinc-200 p-8 space-y-4">
        <div><strong>Mã sự cố:</strong> SC-@Model.IncidentId.ToString("D5")</div>
        <div><strong>Sân:</strong> @Model.FieldName</div>
        <div><strong>Tiêu đề:</strong> @Model.Title</div>
        <div><strong>Mô tả:</strong> @Model.Description</div>
        <div><strong>Trạng thái:</strong> @Model.Status</div>
        <div><strong>Người báo:</strong> @Model.ReportedByName</div>
        <div><strong>Ngày tạo:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        <div><strong>Người xử lý:</strong> @(string.IsNullOrWhiteSpace(Model.HandledByName) ? "Chưa có" : Model.HandledByName)</div>
        <div><strong>Ghi chú xử lý:</strong> @(string.IsNullOrWhiteSpace(Model.HandleNote) ? "Chưa có" : Model.HandleNote)</div>
        <div><strong>Thời gian xử lý:</strong> @(Model.HandledAt.HasValue? Model.HandledAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa có")</div>
    </div>
</div>