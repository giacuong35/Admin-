@model Admin.ViewModels.PurchaseOrders.CreatePurchaseOrderVm
@using Admin.ViewModels.Suppliers
@using Admin.ViewModels.Products

@{
    ViewData["Title"] = "Tạo đơn nhập kho";
    var suppliers = ViewBag.Suppliers as List<SupplierListItemVm> ?? new();
    var products = ViewBag.Products as List<ProductListItemVm> ?? new();
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-2xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Tạo đơn nhập kho
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Lập đơn nhập hàng từ nhà cung cấp và thêm các sản phẩm cần nhập.
            </p>
            <a asp-action="PurchaseOrders" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-full text-sm font-bold shadow-lg">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                <span>Quay lại danh sách</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-8">
        <form asp-action="CreatePurchaseOrder" method="post" class="space-y-8">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label asp-for="SupplierId" class="text-sm font-bold text-zinc-700">Nhà cung cấp</label>
                    <select asp-for="SupplierId" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm">
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.SupplierId">@s.Name - @s.ContactName</option>
                        }
                    </select>
                    <span asp-validation-for="SupplierId" class="text-xs text-red-600"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Note" class="text-sm font-bold text-zinc-700">Ghi chú</label>
                    <input asp-for="Note" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm" />
                    <span asp-validation-for="Note" class="text-xs text-red-600"></span>
                </div>
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <h4 class="font-bold text-zinc-700">Danh sách sản phẩm nhập</h4>
                    <button type="button" id="add-item-btn"
                            class="px-4 py-2 rounded-xl border border-zinc-200 text-sm font-bold text-primary">
                        + Thêm dòng
                    </button>
                </div>

                <div id="items-container" class="space-y-4">
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 item-row">
                            <div>
                                <label class="block text-xs font-bold text-zinc-500 mb-2">Sản phẩm</label>
                                <select asp-for="Items[i].ProductId" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm">
                                    <option value="">-- Chọn sản phẩm --</option>
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.ProductId">@p.Name (@p.Unit)</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-zinc-500 mb-2">Số lượng</label>
                                <input asp-for="Items[i].Quantity" type="number" min="1" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-zinc-500 mb-2">Đơn giá</label>
                                <input asp-for="Items[i].UnitPrice" type="number" step="0.01" min="0.01" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
                            </div>
                            <div class="flex items-end">
                                <button type="button" class="remove-item-btn w-full px-4 py-3 rounded-xl bg-red-50 text-red-600 text-sm font-bold">
                                    Xóa dòng
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                <a asp-action="PurchaseOrders" class="px-6 py-3 rounded-2xl border border-zinc-200 text-sm font-bold text-zinc-600">
                    Hủy
                </a>
                <button type="submit" class="px-6 py-3 rounded-2xl hero-gradient text-white text-sm font-bold shadow-lg">
                    Tạo đơn nhập
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const container = document.getElementById('items-container');
            const addBtn = document.getElementById('add-item-btn');
            const productOptions = `
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var p in products)
                {
                        @:<option value="@p.ProductId">@p.Name (@p.Unit)</option>
                }
            `;

            function reindex() {
                const rows = container.querySelectorAll('.item-row');
                rows.forEach((row, index) => {
                    row.querySelectorAll('select, input').forEach(input => {
                        if (input.name.includes('.ProductId')) input.name = `Items[${index}].ProductId`;
                        if (input.name.includes('.Quantity')) input.name = `Items[${index}].Quantity`;
                        if (input.name.includes('.UnitPrice')) input.name = `Items[${index}].UnitPrice`;

                        if (input.id.includes('__ProductId')) input.id = `Items_${index}__ProductId`;
                        if (input.id.includes('__Quantity')) input.id = `Items_${index}__Quantity`;
                        if (input.id.includes('__UnitPrice')) input.id = `Items_${index}__UnitPrice`;
                    });
                });
            }

            addBtn.addEventListener('click', () => {
                const index = container.querySelectorAll('.item-row').length;
                const html = `
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 item-row">
                        <div>
                            <label class="block text-xs font-bold text-zinc-500 mb-2">Sản phẩm</label>
                            <select name="Items[${index}].ProductId" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm">
                                ${productOptions}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-zinc-500 mb-2">Số lượng</label>
                            <input name="Items[${index}].Quantity" type="number" min="1" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-zinc-500 mb-2">Đơn giá</label>
                            <input name="Items[${index}].UnitPrice" type="number" step="0.01" min="0.01" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
                        </div>
                        <div class="flex items-end">
                            <button type="button" class="remove-item-btn w-full px-4 py-3 rounded-xl bg-red-50 text-red-600 text-sm font-bold">
                                Xóa dòng
                            </button>
                        </div>
                    </div>
                `;
                container.insertAdjacentHTML('beforeend', html);
            });

            container.addEventListener('click', (e) => {
                if (e.target.classList.contains('remove-item-btn')) {
                    const rows = container.querySelectorAll('.item-row');
                    if (rows.length > 1) {
                        e.target.closest('.item-row').remove();
                        reindex();
                    }
                }
            });
        })();
    </script>
}