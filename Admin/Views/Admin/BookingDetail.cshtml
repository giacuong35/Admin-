@model Admin.ViewModels.Bookings.BookingDetailVm

@{
    ViewData["Title"] = "Chi tiết booking";

    var payments = ViewBag.Payments as List<Admin.ViewModels.Bookings.PaymentVm> ?? new();
    var deposit = ViewBag.Deposit as Admin.ViewModels.Bookings.DepositVm;

    var isCancelled = Model.StatusId == 3;
    var isCompleted = Model.StatusId == 4;
    var reachedRescheduleLimit = Model.RescheduleCount > 0;

    var canReschedule = !isCancelled && !isCompleted && !reachedRescheduleLimit;
    var canCancel = !isCancelled && !isCompleted;
    var canComplete = !isCancelled && !isCompleted;
}

@functions {
    public string GetStatusBadgeClass(int statusId)
    {
        return statusId switch
        {
            1 => "bg-amber-50 text-amber-700 border border-amber-200",
            2 => "bg-slate-100 text-slate-700 border border-slate-200",
            3 => "bg-rose-50 text-rose-700 border border-rose-200",
            4 => "bg-emerald-50 text-emerald-700 border border-emerald-200",
            5 => "bg-yellow-50 text-yellow-700 border border-yellow-200",
            _ => "bg-zinc-100 text-zinc-700 border border-zinc-200"
        };
    }

    public string GetPaymentMethodText(int methodId)
    {
        return methodId switch
        {
            1 => "Tiền mặt",
            2 => "MoMo",
            3 => "VNPay",
            _ => "Khác"
        };
    }
}


<section class="hero-gradient rounded-[32px] px-10 py-10 text-white shadow-soft">
    <h1 class="font-manrope text-5xl font-black tracking-tight">CHI TIẾT BOOKING</h1>
    <p class="mt-4 max-w-3xl text-lg text-white/90">
        Theo dõi thông tin đặt sân, đặt cọc, thanh toán và dịch vụ sử dụng.
    </p>
    <div class="mt-8">
        <a asp-action="Bookings"
           asp-controller="Admin"
           class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-primary shadow-sm transition hover:-translate-y-0.5 hover:bg-zinc-50">
            <span class="material-symbols-outlined">arrow_back</span>
            Quay lại danh sách booking
        </a>
    </div>
</section>

<div class="mt-8 grid gap-8 xl:grid-cols-[1.9fr_1fr]">
    <section class="space-y-6">
        <div class="rounded-[30px] border border-zinc-100 bg-white p-8 shadow-soft">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <div class="text-4xl font-black text-primary">
                        BK-@Model.BookingId.ToString("D5")
                    </div>
                    <div class="mt-3 text-zinc-500">
                        Tạo lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold @GetStatusBadgeClass(Model.StatusId)">
                    <span class="inline-block h-2.5 w-2.5 rounded-full bg-current opacity-70"></span>
                    @Model.Status
                </div>
            </div>

            <div class="mt-8 grid gap-6 lg:grid-cols-2">
                <div class="rounded-2xl border border-zinc-100 p-5">
                    <h4 class="mb-4 font-bold text-zinc-700">Khách hàng</h4>
                    <div class="space-y-2 text-sm">
                        <div><span class="font-semibold">Họ tên:</span> @Model.Customer?.FullName</div>
                        <div><span class="font-semibold">Email:</span> @(string.IsNullOrWhiteSpace(Model.Customer?.Email) ? "" : Model.Customer?.Email)</div>
                        <div><span class="font-semibold">SDT:</span> @Model.Customer?.Phone</div>
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 p-5">
                    <h4 class="mb-4 font-bold text-zinc-700">Thông tin tiền</h4>
                    <div class="space-y-2 text-sm">
                        <div><span class="font-semibold">Tạm tính:</span> @Model.SubTotal VNĐ</div>
                        <div><span class="font-semibold">Giảm giá:</span> @Model.DiscountAmount.ToString("N0") VNĐ</div>
                        <div><span class="font-semibold">Thuế:</span> @Model.TaxAmount.ToString("N0") VNĐ</div>
                        <div><span class="font-semibold">Tổng tiền:</span> @Model.TotalAmount VNĐ</div>
                        <div><span class="font-semibold">Tiền cọc:</span> @Model.DepositAmount.ToString("N0") VNĐ</div>
                    </div>
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-zinc-100 p-5">
                <h4 class="mb-4 font-bold text-zinc-700">Slot đã đặt</h4>

                @if (reachedRescheduleLimit)
                {
                    <div class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">
                        Booking này đã đạt giới hạn đổi lịch, không thể đổi thêm.
                    </div>
                }
                else if (isCancelled)
                {
                    <div class="mb-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700">
                        Booking đã bị hủy, không thể đổi lịch.
                    </div>
                }
                else if (isCompleted)
                {
                    <div class="mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-700">
                        Booking đã hoàn thành, không thể đổi lịch.
                    </div>
                }

                <div class="space-y-3">
                    @if (Model.Details != null && Model.Details.Any())
                    {
                        @foreach (var slot in Model.Details)
                        {
                            <div class="flex items-center justify-between gap-4 rounded-xl border border-zinc-100 px-4 py-3 text-sm">
                                <div>
                                    <div class="font-bold text-zinc-700">@slot.FieldName (@slot.FieldType)</div>
                                    <div class="mt-1 text-zinc-500">
                                        @slot.SlotDate.ToString("dd/MM/yyyy") - @slot.StartTime đến @slot.EndTime
                                    </div>
                                </div>

                                <div class="flex items-center gap-3">
                                    <div class="whitespace-nowrap font-bold text-primary">@slot.Price.ToString("N0") VNĐ</div>

                                    @if (canReschedule)
                                    {
                                        <a asp-action="AdminRescheduleBooking"
                                           asp-controller="Admin"
                                           asp-route-bookingId="@Model.BookingId"
                                           asp-route-bookingDetailId="@slot.BookingDetailId"
                                           class="inline-flex items-center gap-2 whitespace-nowrap rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm font-semibold text-emerald-700 transition hover:bg-emerald-100">
                                            <span class="material-symbols-outlined text-[18px]">edit_calendar</span>
                                            Đổi lịch
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rounded-xl border border-zinc-100 px-4 py-4 text-sm text-zinc-500">
                            Không có slot nào.
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 rounded-2xl border border-zinc-100 p-5">
                <h4 class="mb-4 font-bold text-zinc-700">Dịch vụ kèm theo</h4>
                @if (Model.Services != null && Model.Services.Any())
                {
                    <div class="space-y-3">
                        @foreach (var service in Model.Services)
                        {
                            <div class="flex items-center justify-between rounded-xl border border-zinc-100 px-4 py-3 text-sm">
                                <div>
                                    <div class="font-bold text-zinc-700">@service.ServiceName</div>
                                    <div class="mt-1 text-zinc-500">Số lượng: @service.Quantity</div>
                                </div>
                                <div class="text-right">
                                    <div class="text-zinc-500">Đơn giá</div>
                                    <div class="font-bold text-primary">@service.UnitPrice.ToString("N0") VNĐ</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-sm text-zinc-500">Không có dịch vụ đi kèm.</div>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Note))
            {
                <div class="mt-6 rounded-2xl border border-zinc-100 p-5">
                    <h4 class="mb-4 font-bold text-zinc-700">Ghi chú</h4>
                    <div class="whitespace-pre-line text-sm text-zinc-600">@Model.Note</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
            {
                <div class="mt-6 rounded-2xl border border-rose-100 bg-rose-50 p-5">
                    <h4 class="mb-3 font-bold text-rose-700">Lý do hủy</h4>
                    <div class="whitespace-pre-line text-sm text-rose-600">@Model.CancelReason</div>
                </div>
            }
        </div>
    </section>

    <aside class="space-y-6">
        <div class="rounded-[30px] border border-zinc-100 bg-white p-6 shadow-soft">
            <h3 class="mb-4 text-2xl font-black text-zinc-800">Đặt cọc</h3>

            @if (deposit != null)
            {
                <div class="space-y-3 text-sm">
                    <div><span class="font-semibold">Cần cọc:</span> @deposit.RequiredAmount.ToString("N0") VNĐ</div>
                    <div><span class="font-semibold">Đã cọc:</span> @deposit.PaidAmount.ToString("N0") VNĐ</div>
                    <div><span class="font-semibold">Trạng thái:</span> @deposit.Status</div>
                    <div><span class="font-semibold">Deadline:</span> @deposit.DeadlineAt.ToString("dd/MM/yyyy HH:mm")</div>
                    @if (deposit.PaidAt.HasValue)
                    {
                        <div><span class="font-semibold">PaidAt:</span> @deposit.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-zinc-500">Không có dữ liệu đặt cọc.</div>
            }
        </div>

        <div class="rounded-[30px] border border-zinc-100 bg-white p-6 shadow-soft">
            <h3 class="mb-4 text-2xl font-black text-zinc-800">Thanh toán</h3>

            @if (payments.Any())
            {
                <div class="space-y-4">
                    @foreach (var payment in payments)
                    {
                        <div class="rounded-2xl border border-zinc-100 px-4 py-4">
                            <div class="font-extrabold text-zinc-800">@payment.Amount.ToString("N0") VNĐ</div>
                            <div class="mt-2 text-sm text-zinc-600">
                                @GetPaymentMethodText(payment.MethodId) - @payment.Status
                            </div>
                            @if (payment.PaidAt.HasValue)
                            {
                                <div class="mt-1 text-sm text-zinc-400">PaidAt: @payment.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-sm text-zinc-500">Chưa có thanh toán nào.</div>
            }
        </div>

        <div class="rounded-[30px] border border-zinc-100 bg-white p-6 shadow-soft">
            <h3 class="mb-5 text-2xl font-black text-zinc-800">Thao tác</h3>

            <div class="space-y-4">
                @if (Model.StatusId != 4 && Model.StatusId != 3)
                {
                    <a asp-action="RecordBookingPayment"
                       asp-controller="Admin"
                       asp-route-id="@Model.BookingId"
                       class="flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-primary text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-primary-dark">
                        <span class="material-symbols-outlined">payments</span>
                        Ghi nhận thanh toán
                    </a>
                }

                @if (canComplete)
                {
                    <form asp-action="CompleteBooking" asp-controller="Admin" asp-route-id="@Model.BookingId" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-emerald-600 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-emerald-700">
                            <span class="material-symbols-outlined">check_circle</span>
                            Hoàn thành booking
                        </button>
                    </form>
                }
                else if (Model.StatusId == 4)
                {
                    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-sm font-semibold text-emerald-700">
                        Booking này đã hoàn thành.
                    </div>
                }

                @if (canCancel)
                {
                    <form asp-action="CancelBooking" asp-controller="Admin" asp-route-id="@Model.BookingId" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()

                        <textarea name="Reason"
                              rows="3"
                              class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100"
                              placeholder="Lý do hủy (không bắt buộc)"></textarea>

                        <button type="submit"
                                class="flex h-14 w-full items-center justify-center gap-2 rounded-2xl bg-rose-600 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-rose-700">
                            <span class="material-symbols-outlined">cancel</span>
                            Hủy booking
                        </button>
                    </form>
                }
                else if (Model.StatusId == 3)
                {
                    <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm font-semibold text-rose-700">
                        Booking này đã bị hủy.
                    </div>
                }
            </div>
        </div>
    </aside>
</div>