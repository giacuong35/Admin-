@model Admin.ViewModels.Invoices.InvoiceDetailVm

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-3xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Chi tiết hóa đơn
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Thông tin chi tiết của hóa đơn thanh toán.
            </p>

            <a asp-action="Invoices"
               class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-full text-sm font-bold shadow-lg">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                <span>Quay lại danh sách hóa đơn</span>
            </a>
        </div>
    </div>

    <div class="flex items-center gap-3 mb-6">
        <a asp-action="InvoicePreview"
           asp-controller="Admin"
           asp-route-id="@Model.PaymentId"
           target="_blank"
           class="inline-flex items-center gap-2 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-3 text-sm font-bold text-emerald-700 hover:bg-emerald-100 transition">
            <span class="material-symbols-outlined text-[20px]">visibility</span>
            Xem trước bản in
        </a>

        <a asp-action="PrintInvoicePdf"
           asp-controller="Admin"
           asp-route-id="@Model.PaymentId"
           target="_blank"
           class="inline-flex items-center gap-2 rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-700 transition">
            <span class="material-symbols-outlined text-[20px]">print</span>
            In PDF
        </a>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
        <div class="xl:col-span-2 space-y-6">
            <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
                <h3 class="text-xl font-bold text-zinc-800 mb-4">Thông tin hóa đơn</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                    <div><span class="font-bold text-zinc-600">Mã hóa đơn:</span> @Model.InvoiceCode</div>
                    <div><span class="font-bold text-zinc-600">Mã booking:</span> BK-@Model.BookingId.ToString("D5")</div>
                    <div><span class="font-bold text-zinc-600">Khách hàng:</span> @Model.CustomerName</div>
                    <div><span class="font-bold text-zinc-600">Số điện thoại:</span> @Model.CustomerPhone</div>
                    <div><span class="font-bold text-zinc-600">Email:</span> @Model.CustomerEmail</div>
                    <div><span class="font-bold text-zinc-600">Thanh toán lúc:</span> @(Model.PaidAt?.ToString("dd/MM/yyyy HH:mm") ?? "--")</div>
                    <div><span class="font-bold text-zinc-600">Phương thức:</span> @Model.PaymentMethod</div>
                    <div><span class="font-bold text-zinc-600">Mã giao dịch:</span> @(string.IsNullOrWhiteSpace(Model.TransactionCode) ? "--" : Model.TransactionCode)</div>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
                <h3 class="text-xl font-bold text-zinc-800 mb-4">Chi tiết sân</h3>
                <div class="space-y-3">
                    @foreach (var item in Model.Details)
                    {
                        <div class="rounded-2xl border border-zinc-100 p-4">
                            <div class="font-bold text-zinc-800">@item.FieldName (@item.FieldType)</div>
                            <div class="text-sm text-zinc-600 mt-1">
                                @(item.SlotDate.ToString("dd/MM/yyyy")) - @item.StartTime - @item.EndTime
                            </div>
                            <div class="text-sm font-bold text-emerald-700 mt-2">
                                @item.Price.ToString("N0") VNĐ
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
                <h3 class="text-xl font-bold text-zinc-800 mb-4">Dịch vụ đi kèm</h3>
                @if (Model.Services == null || !Model.Services.Any())
                {
                    <div class="text-sm text-zinc-500">Không có dịch vụ đi kèm.</div>
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var service in Model.Services)
                        {
                            <div class="rounded-2xl border border-zinc-100 p-4 flex items-center justify-between gap-4">
                                <div>
                                    <div class="font-bold text-zinc-800">@service.ServiceName</div>
                                    <div class="text-sm text-zinc-600">Số lượng: @service.Quantity</div>
                                </div>
                                <div class="text-sm font-bold text-emerald-700">
                                    @service.Total.ToString("N0") VNĐ
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="space-y-6">
            <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-6">
                <h3 class="text-lg font-bold text-zinc-800 mb-4">Tổng thanh toán</h3>
                <div class="text-3xl font-extrabold text-emerald-700">
                    @Model.Amount.ToString("N0") VNĐ
                </div>
                <div class="mt-3 text-sm text-zinc-600">
                    Trạng thái: <span class="font-bold text-emerald-700">@Model.PaymentStatus</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div class="mt-4 rounded-2xl bg-zinc-50 p-4 text-sm text-zinc-600">
                        <span class="font-bold text-zinc-700">Ghi chú:</span> @Model.Note
                    </div>
                }
            </div>
        </div>
    </div>
</div>