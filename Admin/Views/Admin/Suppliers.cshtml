@{
    ViewData["Title"] = "Nhà Cung Cấp";
}

<div class="p-8 space-y-8 flex-1">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-primary mb-2 block">Quản lý Kho vận</span>
            <h2 class="text-5xl font-black font-manrope tracking-tighter text-on-surface leading-none">Nhà Cung Cấp</h2>
        </div>
        <button class="hero-gradient text-white px-8 py-4 rounded-full font-bold shadow-2xl hover:shadow-primary/20 active:scale-95 transition-all flex items-center gap-2">
            <span class="material-symbols-outlined">add</span>
            Thêm nhà cung cấp
        </button>
    </div>

    <!-- Summary Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border-b-4 border-primary border relative overflow-hidden">
            <div class="relative z-10">
                <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1">Tổng đối tác</p>
                <p class="text-4xl font-black font-manrope">42</p>
                <p class="text-xs text-primary mt-2 flex items-center font-medium">
                    <span class="material-symbols-outlined text-sm mr-1">trending_up</span> +3 tháng này
                </p>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-8xl text-zinc-100 opacity-20 rotate-12">handshake</span>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border-b-4 border-amber-500 border relative overflow-hidden">
            <div class="relative z-10">
                <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1">Thiết bị & Dụng cụ</p>
                <p class="text-4xl font-black font-manrope">18</p>
                <p class="text-xs text-zinc-500 mt-2 font-medium">Nike, Adidas, Molten...</p>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-8xl text-zinc-100 opacity-20 rotate-12">sports_soccer</span>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border-b-4 border-slate-500 border relative overflow-hidden">
            <div class="relative z-10">
                <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1">Đồ uống & Dinh dưỡng</p>
                <p class="text-4xl font-black font-manrope">15</p>
                <p class="text-xs text-zinc-500 mt-2 font-medium">Revive, Pocari, Nestlé...</p>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-8xl text-zinc-100 opacity-20 rotate-12">local_drink</span>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border-b-4 border-zinc-400 border relative overflow-hidden">
            <div class="relative z-10">
                <p class="text-[10px] font-bold uppercase tracking-widest text-zinc-400 mb-1">Dịch vụ bảo trì</p>
                <p class="text-4xl font-black font-manrope">09</p>
                <p class="text-xs text-zinc-500 mt-2 font-medium">Vệ sinh, Sửa chữa sân...</p>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-8xl text-zinc-100 opacity-20 rotate-12">build</span>
        </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white rounded-xl shadow-lg overflow-hidden border border-zinc-200">
        <div class="p-6 flex justify-between items-center bg-zinc-50/50">
            <h3 class="font-bold text-lg">Danh sách nhà cung cấp</h3>
            <div class="flex gap-2">
                <button class="px-4 py-2 bg-white rounded-lg text-sm font-bold border border-zinc-200 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">filter_list</span> Lọc
                </button>
                <button class="px-4 py-2 bg-white rounded-lg text-sm font-bold border border-zinc-200 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">download</span> Xuất CSV
                </button>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-zinc-50">
                        <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-400">Tên nhà cung cấp</th>
                        <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-400">Số điện thoại</th>
                        <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-400">Email</th>
                        <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-400 text-center">Trạng thái</th>
                        <th class="px-6 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-400 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    <tr class="hover:bg-zinc-50 transition-colors group">
                        <td class="px-6 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-lg bg-emerald-100 flex items-center justify-center text-primary font-black">NK</div>
                                <span class="font-bold text-on-surface">Nike Vietnam Co.</span>
                            </div>
                        </td>
                        <td class="px-6 py-5 text-sm text-zinc-500">028 3930 1234</td>
                        <td class="px-6 py-5 text-sm text-zinc-500">contact@nike.com.vn</td>
                        <td class="px-6 py-5 text-center">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 uppercase tracking-wider">
                                <span class="w-1.5 h-1.5 rounded-full bg-primary mr-2 animate-pulse"></span>
                                Partnering
                            </span>
                        </td>
                        <td class="px-6 py-5 text-right">
                            <button class="text-zinc-400 hover:text-primary transition-colors">
                                <span class="material-symbols-outlined">more_vert</span>
                            </button>
                        </td>
                    </tr>
                    @* Thêm các dòng khác tương tự từ file code *@
                </tbody>
            </table>
        </div>
    </div>

    <!-- Visual Decorative Element -->
    <div class="relative h-64 w-full rounded-2xl overflow-hidden group shadow-md border border-zinc-200">
        <img class="absolute inset-0 w-full h-full object-cover grayscale brightness-50 group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvH-MbonV6ZVTYxYZxXGQJ5SC5ycJRYwDJXbTIw3GQ3Amoe0HXB_icr2a9XWP61cJn_puLe8e0mTPPGjctMYK5xe-q-jb9RgEVDcjZr_ZNZ8WTaimOWdfyYlazQra4KoT3R-n1AlEton0cMUEYZRPHbULW_nPPF9nrCLROVV_1KgZMTApN_exCHJb3jeIQLPzdyfXYhowrfamXLXDUP68ezkBjqq9R1paN9hgQfUhX0y91UiKfCn95aAiyyTnR5STaJEBoCioZ1jU" />
        <div class="absolute inset-0 bg-gradient-to-r from-primary/80 to-transparent flex items-center px-12">
            <div class="max-w-lg">
                <h4 class="text-white text-4xl font-black font-manrope tracking-tighter leading-tight mb-4">Chuỗi Cung Ứng Sport Plus</h4>
                <p class="text-white/80 text-sm font-medium leading-relaxed">Kết nối với các thương hiệu thể thao hàng đầu để mang lại trải nghiệm chuyên nghiệp nhất cho vận động viên.</p>
            </div>
        </div>
    </div>
</div>