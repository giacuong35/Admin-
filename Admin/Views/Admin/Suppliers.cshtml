@model Admin.ViewModels.Common.PagedResult<Admin.ViewModels.Suppliers.SupplierListItemVm>

@{
    ViewData["Title"] = "Nhà cung cấp";
    var search = ViewBag.Search as string ?? "";
    var successMessage = TempData["SuccessMessage"]?.ToString();
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-3xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Quản lý nhà cung cấp
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Quản lý danh sách nhà cung cấp, thông tin liên hệ và địa chỉ làm việc.
            </p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-zinc-100 shadow-sm flex flex-col md:flex-row gap-4 md:items-end md:justify-between">
        <form asp-action="Suppliers" method="get" class="flex-1">
            <label class="block text-xs font-bold text-zinc-500 mb-2">Tìm kiếm</label>
            <div class="flex gap-3">
                <input type="text" name="search" value="@search" placeholder="Tên NCC, người liên hệ, SĐT, email..."
                       class="flex-1 rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
                <button type="submit" class="px-5 py-3 rounded-xl hero-gradient text-white text-sm font-bold">
                    Tìm
                </button>
                <a asp-action="Suppliers" class="px-5 py-3 rounded-xl border border-zinc-200 text-sm font-bold text-zinc-600">
                    Xóa lọc
                </a>
            </div>
        </form>

        <div>
            <a asp-action="CreateSupplier"
               class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl hero-gradient text-white text-sm font-bold shadow-lg">
                <span class="material-symbols-outlined text-[20px]">add_business</span>
                <span>Thêm nhà cung cấp</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-100">
            <h3 class="font-manrope font-bold text-xl text-primary">Danh sách nhà cung cấp</h3>
        </div>

        @if (Model != null && Model.Items.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[1100px]">
                    <thead class="bg-zinc-50 border-b border-zinc-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Mã NCC</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Tên nhà cung cấp</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Người liên hệ</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Điện thoại</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Email</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Địa chỉ</th>
                            <th class="px-6 py-4 text-right text-[11px] font-black uppercase tracking-widest text-zinc-400">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-zinc-50/60 transition-all">
                                <td class="px-6 py-5 font-bold text-zinc-700">SUP-@item.SupplierId.ToString("D4")</td>
                                <td class="px-6 py-5 font-bold text-on-surface">@item.Name</td>
                                <td class="px-6 py-5 text-zinc-600">@item.ContactName</td>
                                <td class="px-6 py-5 text-zinc-600">@item.Phone</td>
                                <td class="px-6 py-5 text-zinc-600">@item.Email</td>
                                <td class="px-6 py-5 text-zinc-600 max-w-xs">@item.Address</td>
                                <td class="px-6 py-5 text-right">
                                    <div class="flex justify-end gap-2">
                                        <a asp-action="EditSupplier" asp-route-id="@item.SupplierId"
                                           class="p-2 text-primary hover:bg-emerald-50 rounded-lg transition-all"
                                           title="Chỉnh sửa">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>

                                        <form asp-action="DeleteSupplier" asp-route-id="@item.SupplierId" method="post" class="inline"
                                              onsubmit="return confirm('Bạn chắc chắn muốn xóa nhà cung cấp này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-all"
                                                    title="Xóa">
                                                <span class="material-symbols-outlined text-[20px]">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="px-6 py-4 border-t border-zinc-100 flex items-center justify-between text-sm text-zinc-500">
                <div>Tổng: <span class="font-bold text-zinc-700">@Model.TotalCount</span> nhà cung cấp</div>
                <div>Trang <span class="font-bold text-zinc-700">@Model.Page</span> / @Model.TotalPages</div>
            </div>
        }
        else
        {
            <div class="px-6 py-16 text-center text-zinc-500">
                Không có nhà cung cấp nào.
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.addEventListener('load', function () {
            const successMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage));
            if (typeof Swal !== "undefined" && successMessage) {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: successMessage,
                    confirmButtonColor: '#006418',
                    confirmButtonText: 'Đóng'
                });
            }
        });
    </script>
}