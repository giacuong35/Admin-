@model Admin.ViewModels.Fields.CreateFieldVm

@{
    ViewData["Title"] = "Thêm sân mới";
}

<div class="min-h-screen bg-slate-50 p-6">
    <div class="max-w-4xl mx-auto">
        <div class="mb-6">
            <h1 class="text-3xl font-extrabold text-slate-800">Thêm sân mới</h1>
            <p class="text-slate-500 mt-2">Nhập thông tin sân bóng để tạo mới trong hệ thống.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-slate-200 p-8">
            <form asp-action="CreateField" asp-controller="Admin" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm font-medium"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label asp-for="Name" class="block text-sm font-bold text-slate-700 mb-2">Tên sân</label>
                        <input asp-for="Name"
                               class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500"
                               placeholder="Ví dụ: Sân 5A" />
                        <span asp-validation-for="Name" class="text-red-600 text-sm"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Description" class="block text-sm font-bold text-slate-700 mb-2">Mô tả</label>
                        <textarea asp-for="Description"
                                  rows="4"
                                  class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500"
                                  placeholder="Nhập mô tả sân..."></textarea>
                        <span asp-validation-for="Description" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="BasePrice" class="block text-sm font-bold text-slate-700 mb-2">Giá cơ bản</label>
                        <input asp-for="BasePrice"
                               type="number"
                               min="1000"
                               step="1000"
                               class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500"
                               placeholder="Ví dụ: 200000" />
                        <span asp-validation-for="BasePrice" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="PeakPrice" class="block text-sm font-bold text-slate-700 mb-2">Giá cao điểm</label>
                        <input asp-for="PeakPrice"
                               type="number"
                               min="1000"
                               step="1000"
                               class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500"
                               placeholder="Ví dụ: 250000" />
                        <span asp-validation-for="PeakPrice" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="TypeId" class="block text-sm font-bold text-slate-700 mb-2">Loại sân</label>
                        <select asp-for="TypeId"
                                class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500">
                            <option value="1">Sân 5 người</option>
                            <option value="2">Sân 7 người</option>
                        </select>
                        <span asp-validation-for="TypeId" class="text-red-600 text-sm"></span>
                    </div>

                    <div>
                        <label asp-for="StatusId" class="block text-sm font-bold text-slate-700 mb-2">Trạng thái</label>
                        <select asp-for="StatusId"
                                class="w-full rounded-2xl border border-slate-300 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500">
                            <option value="1">Đang hoạt động</option>
                            <option value="2">Bảo trì</option>
                            <option value="3">Ngưng hoạt động</option>
                        </select>
                        <span asp-validation-for="StatusId" class="text-red-600 text-sm"></span>
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="ImageFile" class="block text-sm font-bold text-slate-700 mb-2">Ảnh sân</label>
                        <input asp-for="ImageFile"
                               type="file"
                               accept="image/*"
                               class="w-full rounded-2xl border border-slate-300 px-4 py-3 bg-white focus:outline-none focus:ring-4 focus:ring-emerald-100 focus:border-emerald-500" />
                        <span asp-validation-for="ImageFile" class="text-red-600 text-sm"></span>
                        <p class="text-xs text-slate-500 mt-2">Ảnh sẽ được tải lên sau khi tạo sân thành công.</p>
                    </div>
                </div>

                <div class="flex items-center gap-4 pt-4">
                    <button type="submit"
                            class="inline-flex items-center justify-center rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-3 shadow-sm transition-all">
                        Lưu sân mới
                    </button>

                    <a asp-action="Fields"
                       asp-controller="Admin"
                       class="inline-flex items-center justify-center rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-6 py-3 transition-all">
                        Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}