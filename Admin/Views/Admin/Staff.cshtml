@{
    ViewData["Title"] = "Quản lý nhân viên";
}

@model IEnumerable<Admin.ViewModels.Users.UserListItemVm>

@{
    int? selectedStatus = ViewBag.StatusId as int?;
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";
    
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-2xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Đội ngũ vận hành
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Quản lý quyền truy cập của đội ngũ Sport Plus tại đây. Nền tảng chuyên nghiệp dành cho những nhà điều hành thể thao hàng đầu.
            </p>
            <a asp-action="CreateStaff" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-full text-sm font-bold shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:scale-95 transition-all w-fit">
                <span class="material-symbols-outlined text-[20px]">person_add</span>
                <span>Thêm nhân viên</span>
            </a>
        </div>
        <div class="absolute right-0 top-0 h-full w-1/3 opacity-20 pointer-events-none">
            <img class="w-full h-full object-cover mix-blend-overlay" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_LUa_DWcbY2EePqqF7yfs83sv2JdRxHGCO6dFX0XQjs0PNa4XzVeg-myw7fvoUID-Ev65XFsOcvun-S4JH5SceaHxCAqAy5vuH6-aNnlOXYj1dw7B6jcrovTEFmKe9KzIZBH1-0dgFydxHEpPcX3odWzgeL57_KbMqQrNeDxOO6ydFvy0LWlQ3F2s7J323dZc9UXDVpC10N-MoK-dRLSGis7BSmwcn9GGwmRKtnT3bbWCLFacf6fmNCv3oBiBV5elhrx1WwJ0M6c" />
        </div>
    </div>

    <div class="px-6 py-4 border-b border-zinc-100 flex justify-between items-center bg-white">
        <h3 class="font-manrope font-bold text-xl text-primary">Danh sách nhân sự</h3>

        <details class="relative">
            <summary class="flex items-center gap-1 px-3 py-1.5 text-xs font-bold uppercase tracking-wider text-secondary border border-zinc-200 rounded-lg hover:bg-zinc-50 transition-colors cursor-pointer list-none">
                <span class="material-symbols-outlined text-sm">filter_list</span>
                Bộ lọc
            </summary>

            <div class="absolute right-0 mt-3 w-[760px] max-w-[90vw] bg-white border border-zinc-200 rounded-2xl shadow-xl p-4 z-20">
                <form asp-action="Staff" method="get" class="grid grid-cols-1 md:grid-cols-4 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase mb-1">Từ khóa</label>
                        <input type="text" name="keyword" value="@keyword" placeholder="Tên / Email / SĐT"
                               class="w-full rounded-xl border border-zinc-200 px-3 py-2 text-sm" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase mb-1">Trạng thái</label>
                        <select name="statusId" class="w-full rounded-xl border border-zinc-200 px-3 py-2 text-sm">
                            <option value="">Tất cả</option>
                            <option value="1" selected="@(selectedStatus == 1)">Hoạt động</option>
                            <option value="2" selected="@(selectedStatus == 2)">Tạm khóa</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase mb-1">Từ ngày</label>
                        <input type="date" name="fromDate" value="@fromDate"
                               class="w-full rounded-xl border border-zinc-200 px-3 py-2 text-sm" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-zinc-500 uppercase mb-1">Đến ngày</label>
                        <input type="date" name="toDate" value="@toDate"
                               class="w-full rounded-xl border border-zinc-200 px-3 py-2 text-sm" />
                    </div>

                    <div class="md:col-span-4 flex justify-end gap-2 pt-2">
                        <a asp-action="Staff" class="px-4 py-2 rounded-xl border border-zinc-200 text-sm font-bold text-zinc-600">
                            Xóa lọc
                        </a>
                        <button type="submit" class="px-4 py-2 rounded-xl bg-primary text-white text-sm font-bold">
                            Áp dụng
                        </button>
                    </div>
                </form>
            </div>
        </details>
    </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-zinc-50">
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Nhân viên</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Liên hệ</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500">Trạng thái</th>
                        <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-zinc-500 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var person in Model)
                        {
                            var avatarLetter = string.IsNullOrWhiteSpace(person.FullName) ? "?" : person.FullName.Substring(0, 1).ToUpper();

                            <tr class="hover:bg-zinc-50 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-primary font-bold">
                                            @avatarLetter
                                        </div>
                                        <div>
                                            <p class="font-bold text-on-surface text-sm">@person.FullName</p>
                                            <p class="text-[10px] text-zinc-400">ID: SP-@person.UserId.ToString("D4")</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-6 py-4 text-sm">
                                    <p class="font-medium">@person.Email</p>
                                    <p class="text-xs text-zinc-400">@person.Phone</p>
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full @(person.StatusId == 1 ? "bg-primary animate-pulse" : "bg-error")"></span>
                                        <span class="text-sm font-medium @(person.StatusId == 1 ? "text-primary" : "text-error")">
                                            @(person.Status ?? (person.StatusId == 1 ? "Hoạt động" : "Tạm khóa"))
                                        </span>
                                    </div>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                        <a asp-action="EditStaff" asp-route-id="@person.UserId" class="p-2 text-primary hover:bg-emerald-50 rounded-lg" title="Chỉnh sửa">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>

                                        @if (person.StatusId == 1)
                                        {
                                            <form asp-action="LockStaff" asp-route-id="@person.UserId" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-2 text-amber-600 hover:bg-amber-50 rounded-lg" title="Khóa tài khoản">
                                                    <span class="material-symbols-outlined">lock</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnlockStaff" asp-route-id="@person.UserId" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg" title="Mở khóa tài khoản">
                                                    <span class="material-symbols-outlined">lock_open</span>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="DeleteStaff" asp-route-id="@person.UserId" method="post" class="inline"
                                              onsubmit="return confirm('Bạn chắc chắn muốn xóa nhân viên này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="p-2 text-error hover:bg-red-50 rounded-lg" title="Xóa nhân viên">
                                                <span class="material-symbols-outlined">delete</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-zinc-400">
                                <div class="flex flex-col items-center gap-2 opacity-30">
                                    <span class="material-symbols-outlined text-5xl">person_off</span>
                                    <p class="font-bold uppercase tracking-widest text-xs">Chưa có dữ liệu nhân viên nào</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
