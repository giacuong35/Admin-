@model Admin.ViewModels.Dashboard.DashboardPageVm

@{
    ViewData["Title"] = "Báo cáo";
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-3xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Báo cáo hệ thống
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Phân tích doanh thu theo tháng, tỷ lệ lấp đầy sân và đóng góp doanh thu của từng dịch vụ.
            </p>
        </div>
    </div>

    <div class="bg-white p-6 rounded-3xl border border-zinc-100 shadow-sm">
        <form asp-action="Reports" method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
                <label class="block text-xs font-bold text-zinc-500 mb-2">Năm</label>
                <input type="number" name="year" value="@Model.SelectedYear" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm" />
            </div>

            <div>
                <label class="block text-xs font-bold text-zinc-500 mb-2">Tháng</label>
                <select name="month" class="w-full rounded-xl border border-zinc-200 px-4 py-3 text-sm">
                    <option value="">Tất cả</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.SelectedMonth == m)">Tháng @m</option>
                    }
                </select>
            </div>

            <div class="flex items-end gap-3">
                <a asp-action="Reports" class="px-5 py-3 rounded-xl border border-zinc-200 text-sm font-bold text-zinc-600">Xóa lọc</a>
                <button type="submit" class="px-5 py-3 rounded-xl hero-gradient text-white text-sm font-bold">Xem báo cáo</button>
            </div>
        </form>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-100">
                <h3 class="font-manrope font-bold text-xl text-primary">
                    Tổng quan tháng @(Model.MonthlyReport.Month.ToString("D2"))/@Model.MonthlyReport.Year
                </h3>
            </div>

            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">Tổng doanh thu</div>
                    <div class="mt-3 text-2xl font-extrabold text-primary">
                        @Model.MonthlyReport.TotalRevenue.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">Tiền mặt</div>
                    <div class="mt-3 text-2xl font-extrabold text-zinc-800">
                        @Model.MonthlyReport.CashRevenue.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">VNPay</div>
                    <div class="mt-3 text-2xl font-extrabold text-zinc-800">
                        @Model.MonthlyReport.VnPayRevenue.ToString("N0") VNĐ
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">Tổng đặt sân</div>
                    <div class="mt-3 text-2xl font-extrabold text-zinc-800">
                        @Model.MonthlyReport.TotalBookings
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">Đã hoàn thành</div>
                    <div class="mt-3 text-2xl font-extrabold text-emerald-600">
                        @Model.MonthlyReport.CompletedBookings
                    </div>
                </div>

                <div class="rounded-2xl border border-zinc-100 bg-zinc-50 p-5">
                    <div class="text-xs font-black uppercase tracking-widest text-zinc-400">Đã hủy</div>
                    <div class="mt-3 text-2xl font-extrabold text-rose-600">
                        @Model.MonthlyReport.CancelledBookings
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-zinc-100">
                <h3 class="font-manrope font-bold text-xl text-primary">Tỷ lệ lấp đầy sân</h3>
            </div>

            @if (Model.FieldOccupancy.Any())
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[700px]">
                        <thead class="bg-zinc-50 border-b border-zinc-100">
                            <tr>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Sân</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Loại sân</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Booked/Total</th>
                                <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Occupancy</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100">
                            @foreach (var item in Model.FieldOccupancy.OrderByDescending(x => x.OccupancyRate))
                            {
                                <tr>
                                    <td class="px-6 py-4 font-bold text-zinc-700">@item.FieldName</td>
                                    <td class="px-6 py-4 text-zinc-600">@item.FieldType</td>
                                    <td class="px-6 py-4 text-zinc-600">@item.BookedSlots / @item.TotalSlots</td>
                                    <td class="px-6 py-4 font-bold text-emerald-600">@item.OccupancyRate.ToString("N2")%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="px-6 py-12 text-center text-zinc-500">Không có dữ liệu.</div>
            }
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-zinc-100">
            <h3 class="font-manrope font-bold text-xl text-primary">Doanh thu theo dịch vụ</h3>
        </div>

        @if (Model.RevenueByService.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full min-w-[800px]">
                    <thead class="bg-zinc-50 border-b border-zinc-100">
                        <tr>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Dịch vụ</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Số lượng bán</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Số booking</th>
                            <th class="px-6 py-4 text-left text-[11px] font-black uppercase tracking-widest text-zinc-400">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100">
                        @foreach (var item in Model.RevenueByService.OrderByDescending(x => x.TotalRevenue))
                        {
                            <tr>
                                <td class="px-6 py-4 font-bold text-zinc-700">@item.ServiceName</td>
                                <td class="px-6 py-4 text-zinc-600">@item.TotalQuantitySold</td>
                                <td class="px-6 py-4 text-zinc-600">@item.TotalBookings</td>
                                <td class="px-6 py-4 font-bold text-primary">@item.TotalRevenue.ToString("N0") VNĐ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-6 py-12 text-center text-zinc-500">Không có dữ liệu.</div>
        }
    </div>
</div>