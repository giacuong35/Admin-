@model Admin.ViewModels.Backups.BackupPageVm
@{
    ViewData["Title"] = "Sao lưu & khôi phục";
}

<div class="p-8 space-y-6">
    <div class="rounded-3xl hero-gradient text-white p-8 shadow-lg">
        <h1 class="text-4xl font-black">SAO LƯU & KHÔI PHỤC</h1>
        <p class="mt-3 text-white/90 text-base">
            Quản lý backup, snapshot và khôi phục dữ liệu hệ thống Sport Plus.
        </p>
    </div>

    <div class="rounded-3xl border border-amber-200 bg-amber-50 p-6">
        <h3 class="text-2xl font-extrabold text-amber-800">Hướng dẫn sử dụng an toàn</h3>
        <div class="mt-4 space-y-2 text-sm text-amber-900">
            <p>1. Luôn <span class="font-bold">tạo snapshot</span> trước khi thực hiện restore.</p>
            <p>2. Restore sẽ <span class="font-bold">ghi đè dữ liệu hiện tại</span> và không nên bấm khi chưa kiểm tra kỹ.</p>
            <p>3. Backup <span class="font-bold">không bao gồm ảnh upload</span> trong thư mục Uploads.</p>
            <p>4. Sau khi restore, hãy kiểm tra lại khách hàng, booking, hóa đơn và các dữ liệu quan trọng.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="rounded-3xl bg-white border border-zinc-200 p-6 shadow-sm space-y-5">
            <div>
                <h3 class="text-3xl font-extrabold text-zinc-800">Sao lưu</h3>
                <p class="mt-2 text-sm text-zinc-500">
                    Tạo file backup tải về máy hoặc tạo snapshot lưu trên server trước các thao tác quan trọng.
                </p>
            </div>

            <div class="flex flex-wrap gap-3">
                <a asp-action="ExportBackup"
                   class="inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-700 shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">download</span>
                    Tải backup về máy
                </a>

                <form asp-action="CreateBackupSnapshot" method="post" class="snapshot-form">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="snapshot-submit inline-flex items-center justify-center gap-2 rounded-2xl border border-emerald-300 bg-emerald-50 px-6 py-3 text-sm font-bold text-emerald-700 transition hover:bg-emerald-100">
                        <span class="material-symbols-outlined text-[20px]">add_circle</span>
                        <span class="snapshot-submit-text">Tạo snapshot</span>
                    </button>
                </form>
            </div>

            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 text-sm text-zinc-700">
                <p><span class="font-bold text-zinc-900">Snapshot</span> là bản sao lưu lưu trên server để có thể restore nhanh.</p>
                <p class="mt-2"><span class="font-bold text-zinc-900">Export backup</span> là tạo file .zip tải về máy, phù hợp để lưu offline.</p>
            </div>

            <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
                Backup chỉ lưu dữ liệu hệ thống, <span class="font-bold">không bao gồm ảnh upload trong thư mục Uploads</span>.
            </div>
        </div>

        <div class="rounded-3xl bg-white border border-zinc-200 p-6 shadow-sm space-y-5">
            <div>
                <h3 class="text-3xl font-extrabold text-zinc-800">Khôi phục từ file</h3>
                <p class="mt-2 text-sm text-zinc-500">
                    Upload file .zip backup để khôi phục dữ liệu hệ thống.
                </p>
            </div>

            <form asp-action="RestoreBackupFromFile" method="post" enctype="multipart/form-data" class="space-y-4" id="restoreFileForm">
                @Html.AntiForgeryToken()

                <div>
                    <label class="mb-2 block text-sm font-bold text-zinc-700">Chọn file backup (.zip)</label>
                    <input type="file"
                           id="restoreFileInput"
                           name="file"
                           accept=".zip"
                           class="block w-full rounded-2xl border border-zinc-300 px-4 py-3 text-sm file:mr-4 file:rounded-xl file:border-0 file:bg-zinc-100 file:px-4 file:py-2 file:font-bold file:text-zinc-700 hover:file:bg-zinc-200" />
                    <p id="selectedFileName" class="mt-2 text-sm text-zinc-500">Chưa chọn file nào.</p>
                </div>

                <div class="rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700">
                    <p class="font-bold">Cảnh báo:</p>
                    <p class="mt-1">Khôi phục sẽ ghi đè dữ liệu hiện tại. Chỉ thực hiện khi bạn chắc chắn đã sao lưu hoặc tạo snapshot trước đó.</p>
                </div>

                <div>
                    <label for="restoreFileConfirm" class="mb-2 block text-sm font-bold text-zinc-700">
                        Nhập <span class="text-rose-600">RESTORE</span> để xác nhận
                    </label>
                    <input type="text"
                           id="restoreFileConfirm"
                           autocomplete="off"
                           class="w-full rounded-2xl border border-zinc-300 px-4 py-3 text-sm focus:border-rose-400 focus:outline-none focus:ring-2 focus:ring-rose-100"
                           placeholder="Nhập RESTORE để mở nút khôi phục" />
                </div>

                <button type="submit"
                        id="restoreFileSubmit"
                        disabled
                        class="inline-flex items-center justify-center gap-2 rounded-2xl bg-rose-600 px-6 py-3 text-sm font-bold text-white transition disabled:cursor-not-allowed disabled:opacity-50 hover:bg-rose-700">
                    <span class="material-symbols-outlined text-[20px]">restore</span>
                    <span id="restoreFileSubmitText">Khôi phục từ file</span>
                </button>
            </form>
        </div>
    </div>

    <div class="rounded-3xl bg-white border border-zinc-200 p-6 shadow-sm">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between mb-5">
            <div>
                <h3 class="text-3xl font-extrabold text-zinc-800">Danh sách snapshot</h3>
                <p class="mt-1 text-sm text-zinc-500">
                    Snapshot mới nhất nằm trên cùng. Chỉ restore khi đã xác nhận đúng thời điểm cần quay lại.
                </p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-zinc-200 text-zinc-500 text-sm">
                        <th class="px-4 py-3">Tên file</th>
                        <th class="px-4 py-3">Dung lượng</th>
                        <th class="px-4 py-3">Ngày tạo</th>
                        <th class="px-4 py-3 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Snapshots != null && Model.Snapshots.Any())
                    {
                        foreach (var item in Model.Snapshots)
                        {
                            var safeId = item.FileName
                            .Replace(".", "_")
                            .Replace("-", "_")
                            .Replace(" ", "_");

                            <tr class="border-b border-zinc-100 align-top">
                                <td class="px-4 py-4">
                                    <div class="font-bold text-zinc-800 break-all">@item.FileName</div>
                                    <div class="mt-2 inline-flex items-center rounded-full bg-zinc-100 px-3 py-1 text-xs font-semibold text-zinc-600">
                                        Snapshot server
                                    </div>
                                </td>
                                <td class="px-4 py-4 text-zinc-600">@item.SizeLabel</td>
                                <td class="px-4 py-4 text-zinc-600">@item.CreatedAtLabel</td>
                                <td class="px-4 py-4">
                                    <div class="flex justify-end gap-2 flex-wrap">
                                        <a asp-action="DownloadSnapshot"
                                           asp-route-fileName="@item.FileName"
                                           class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-4 py-2 text-sm font-bold text-zinc-700 hover:bg-zinc-100">
                                            <span class="material-symbols-outlined text-[18px]">download</span>
                                            Tải về
                                        </a>

                                        <button type="button"
                                                onclick="openRestoreSnapshotModal('@safeId')"
                                                class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-4 py-2 text-sm font-bold text-white hover:bg-amber-600">
                                            <span class="material-symbols-outlined text-[18px]">restore</span>
                                            Restore
                                        </button>

                                        <form asp-action="DeleteSnapshot" method="post" class="delete-snapshot-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fileName" value="@item.FileName" />
                                            <button type="submit"
                                                    onclick="return confirm('Bạn chắc chắn muốn xóa snapshot này? Thao tác này không thể hoàn tác.')"
                                                    class="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2 text-sm font-bold text-white hover:bg-rose-700">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                                Xóa
                                            </button>
                                        </form>
                                    </div>

                                    <div id="restoreSnapshotModal_@safeId" class="fixed inset-0 z-[9998] hidden items-center justify-center bg-black/40 px-4">
                                        <div class="w-full max-w-lg rounded-3xl bg-white p-6 shadow-2xl">
                                            <h4 class="text-2xl font-extrabold text-zinc-800">Xác nhận restore snapshot</h4>
                                            <p class="mt-3 text-sm text-zinc-600">
                                                Bạn đang chuẩn bị khôi phục từ snapshot:
                                            </p>
                                            <div class="mt-3 rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 text-sm font-bold text-zinc-800 break-all">
                                                @item.FileName
                                            </div>

                                            <div class="mt-4 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-700">
                                                <p class="font-bold">Cảnh báo:</p>
                                                <p class="mt-1">Dữ liệu hiện tại sẽ bị thay thế. Hãy chỉ tiếp tục khi bạn chắc chắn đây là snapshot đúng cần khôi phục.</p>
                                            </div>

                                            <div class="mt-4">
                                                <label class="mb-2 block text-sm font-bold text-zinc-700">
                                                    Nhập <span class="text-rose-600">RESTORE</span> để xác nhận
                                                </label>
                                                <input type="text"
                                                       id="restoreSnapshotConfirm_@safeId"
                                                       autocomplete="off"
                                                       oninput="toggleRestoreSnapshotButton('@safeId')"
                                                       class="w-full rounded-2xl border border-zinc-300 px-4 py-3 text-sm focus:border-amber-400 focus:outline-none focus:ring-2 focus:ring-amber-100"
                                                       placeholder="Nhập RESTORE để mở nút restore" />
                                            </div>

                                            <div class="mt-6 flex items-center justify-end gap-3">
                                                <button type="button"
                                                        onclick="closeRestoreSnapshotModal('@safeId')"
                                                        class="rounded-xl border border-zinc-300 px-5 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-100">
                                                    Hủy
                                                </button>

                                                <form asp-action="RestoreSnapshot" method="post" class="restore-snapshot-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="fileName" value="@item.FileName" />
                                                    <button type="submit"
                                                            id="restoreSnapshotSubmit_@safeId"
                                                            disabled
                                                            class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-5 py-3 text-sm font-bold text-white disabled:cursor-not-allowed disabled:opacity-50 hover:bg-amber-600">
                                                        <span class="material-symbols-outlined text-[18px]">restore</span>
                                                        <span id="restoreSnapshotSubmitText_@safeId">Xác nhận restore</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-4 py-10 text-center text-zinc-500">
                                Chưa có snapshot nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const restoreFileInput = document.getElementById('restoreFileInput');
        const selectedFileName = document.getElementById('selectedFileName');
        const restoreFileConfirm = document.getElementById('restoreFileConfirm');
        const restoreFileSubmit = document.getElementById('restoreFileSubmit');
        const restoreFileSubmitText = document.getElementById('restoreFileSubmitText');
        const restoreFileForm = document.getElementById('restoreFileForm');

        function updateRestoreFileButton() {
            const hasFile = restoreFileInput && restoreFileInput.files && restoreFileInput.files.length > 0;
            const confirmed = restoreFileConfirm && restoreFileConfirm.value.trim() === 'RESTORE';
            restoreFileSubmit.disabled = !(hasFile && confirmed);
        }

        if (restoreFileInput) {
            restoreFileInput.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    selectedFileName.textContent = `Đã chọn: ${this.files[0].name}`;
                } else {
                    selectedFileName.textContent = 'Chưa chọn file nào.';
                }
                updateRestoreFileButton();
            });
        }

        if (restoreFileConfirm) {
            restoreFileConfirm.addEventListener('input', updateRestoreFileButton);
        }

        if (restoreFileForm) {
            restoreFileForm.addEventListener('submit', function () {
                restoreFileSubmit.disabled = true;
                restoreFileSubmitText.textContent = 'Đang khôi phục...';
            });
        }

        document.querySelectorAll('.snapshot-form').forEach(form => {
            form.addEventListener('submit', function () {
                const button = form.querySelector('.snapshot-submit');
                const text = form.querySelector('.snapshot-submit-text');
                if (button) button.disabled = true;
                if (text) text.textContent = 'Đang tạo...';
            });
        });

        document.querySelectorAll('.restore-snapshot-form').forEach(form => {
            form.addEventListener('submit', function () {
                const button = form.querySelector('button[type="submit"]');
                const text = form.querySelector('span[id^="restoreSnapshotSubmitText_"]');
                if (button) button.disabled = true;
                if (text) text.textContent = 'Đang restore...';
            });
        });

        function openRestoreSnapshotModal(id) {
            const modal = document.getElementById(`restoreSnapshotModal_${id}`);
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeRestoreSnapshotModal(id) {
            const modal = document.getElementById(`restoreSnapshotModal_${id}`);
            const input = document.getElementById(`restoreSnapshotConfirm_${id}`);
            const button = document.getElementById(`restoreSnapshotSubmit_${id}`);

            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }

            if (input) input.value = '';
            if (button) button.disabled = true;
        }

        function toggleRestoreSnapshotButton(id) {
            const input = document.getElementById(`restoreSnapshotConfirm_${id}`);
            const button = document.getElementById(`restoreSnapshotSubmit_${id}`);
            if (input && button) {
                button.disabled = input.value.trim() !== 'RESTORE';
            }
        }
    </script>
}