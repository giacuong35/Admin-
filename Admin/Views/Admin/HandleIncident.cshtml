@model Admin.ViewModels.Incidents.HandleIncidentVm
@{
    ViewData["Title"] = "Xử lý sự cố";
    var incident = ViewBag.Incident as Admin.ViewModels.Incidents.IncidentDetailVm;
}

<div class="p-8">
    <div class="bg-white rounded-3xl border border-zinc-200 p-8 max-w-3xl">
        <h1 class="text-3xl font-extrabold text-zinc-800 mb-6">Xử lý sự cố</h1>

        @if (incident != null)
        {
            <div class="mb-6 rounded-2xl bg-zinc-50 border border-zinc-200 p-4">
                <p><strong>Sự cố:</strong> @incident.Title</p>
                <p><strong>Sân:</strong> @incident.FieldName</p>
                <p><strong>Mô tả:</strong> @incident.Description</p>
            </div>
        }

        <form asp-action="HandleIncident" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-sm font-bold text-zinc-700 mb-2">Trạng thái</label>
                <select asp-for="StatusId" class="w-full rounded-2xl border border-zinc-300 px-4 py-3">
                    <option value="1">Mới tạo</option>
                    <option value="2">Đang xử lý</option>
                    <option value="3">Đã xử lý</option>
                </select>
            </div>

            <div>
                <label class="block text-sm font-bold text-zinc-700 mb-2">Ghi chú xử lý</label>
                <textarea asp-for="HandleNote" rows="5" class="w-full rounded-2xl border border-zinc-300 px-4 py-3"></textarea>
            </div>

            <div class="flex items-center gap-3">
                <button type="submit" class="rounded-2xl bg-emerald-600 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-700">
                    Cập nhật xử lý
                </button>
                <a asp-action="IncidentDetail" asp-route-id="@incident?.IncidentId" class="rounded-2xl border border-zinc-300 px-5 py-3 text-sm font-bold text-zinc-700 hover:bg-zinc-100">
                    Quay lại
                </a>
            </div>
        </form>
    </div>
</div>