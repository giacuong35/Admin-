@model Admin.ViewModels.Suppliers.CreateSupplierVm

@{
    ViewData["Title"] = "Thêm nhà cung cấp";
}

<div class="p-8 space-y-8 flex-1">
    <div class="relative overflow-hidden rounded-xl hero-gradient p-10 text-white shadow-lg">
        <div class="relative z-10 max-w-2xl">
            <h2 class="text-4xl md:text-5xl font-manrope font-extrabold tracking-tight leading-none mb-4 uppercase">
                Thêm nhà cung cấp
            </h2>
            <p class="font-medium text-lg mb-6 opacity-90">
                Tạo mới nhà cung cấp để phục vụ quản lý kho và nhập hàng.
            </p>
            <a asp-action="Suppliers" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white text-primary rounded-full text-sm font-bold shadow-lg">
                <span class="material-symbols-outlined text-[20px]">arrow_back</span>
                <span>Quay lại danh sách</span>
            </a>
        </div>
    </div>

    <div class="bg-white rounded-3xl border border-zinc-100 shadow-sm p-8">
        <form asp-action="CreateSupplier" method="post" class="space-y-8">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm p-4"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-2">
                    <label asp-for="Name" class="text-sm font-bold text-zinc-700">Tên nhà cung cấp</label>
                    <input asp-for="Name" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm" />
                    <span asp-validation-for="Name" class="text-xs text-red-600"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="ContactName" class="text-sm font-bold text-zinc-700">Người liên hệ</label>
                    <input asp-for="ContactName" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm" />
                    <span asp-validation-for="ContactName" class="text-xs text-red-600"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Phone" class="text-sm font-bold text-zinc-700">Số điện thoại</label>
                    <input asp-for="Phone" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm" />
                    <span asp-validation-for="Phone" class="text-xs text-red-600"></span>
                </div>

                <div class="space-y-2">
                    <label asp-for="Email" class="text-sm font-bold text-zinc-700">Email</label>
                    <input asp-for="Email" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm" />
                    <span asp-validation-for="Email" class="text-xs text-red-600"></span>
                </div>

                <div class="space-y-2 md:col-span-2">
                    <label asp-for="Address" class="text-sm font-bold text-zinc-700">Địa chỉ</label>
                    <textarea asp-for="Address" rows="4" class="w-full rounded-2xl border border-zinc-200 px-4 py-3 text-sm resize-none"></textarea>
                    <span asp-validation-for="Address" class="text-xs text-red-600"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-zinc-100">
                <a asp-action="Suppliers" class="px-6 py-3 rounded-2xl border border-zinc-200 text-sm font-bold text-zinc-600">
                    Hủy
                </a>
                <button type="submit" class="px-6 py-3 rounded-2xl hero-gradient text-white text-sm font-bold shadow-lg">
                    Tạo nhà cung cấp
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}