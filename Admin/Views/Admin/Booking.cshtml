@{
    ViewData["Title"] = "Quản lý đặt sân";
}

<div class="p-8 space-y-8 flex-1">
    <!-- Hero Header Section -->
    <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary mb-2 block">Quản lý hệ thống</span>
            <h1 class="text-5xl font-manrope font-extrabold tracking-tighter text-on-surface leading-none">Danh sách đặt sân</h1>
        </div>
        <div class="flex items-center gap-3">
            <button class="px-6 py-3 bg-white text-emerald-700 border-2 border-emerald-700 rounded-full font-bold hover:bg-emerald-50 active:scale-95 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined">filter_list</span>
                Bộ lọc
            </button>
            <button class="px-8 py-3 bg-primary text-white rounded-full font-bold shadow-xl hover:shadow-primary/20 active:scale-95 transition-all flex items-center gap-2">
                <span class="material-symbols-outlined">add</span>
                 Tạo đặt sân mới
            </button>
        </div>
    </div>

    <!-- Quick Filters & Search Canvas -->
    <div class="bg-white/80 backdrop-blur-md p-6 rounded-xl shadow-sm border border-zinc-200 flex flex-wrap gap-4 items-center">
        <div class="flex flex-col gap-1 flex-1 min-w-[240px]">
            <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold ml-1">Tìm kiếm nâng cao</span>
            <input class="w-full bg-zinc-100 border-none rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary/20" placeholder="Mã đơn, Tên khách, Sân..." type="text" />
        </div>
        <div class="flex flex-col gap-1 min-w-[150px]">
            <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold ml-1">Trạng thái</span>
            <select class="bg-zinc-100 border-none rounded-xl px-4 py-3 text-sm">
                <option>Tất cả</option>
                <option>Paid</option>
                <option>Pending</option>
                <option>Cancelled</option>
            </select>
        </div>
    </div>

    <!-- Booking Table -->
    <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-zinc-200">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-zinc-50 border-b border-zinc-100">
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Booking ID</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Khách hàng</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Sân</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Thời gian</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Tổng tiền</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Trạng thái</th>
                        <th class="px-6 py-4 text-[10px] uppercase tracking-widest text-zinc-500 font-bold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-100">
                    <!-- Row mẫu -->
                    <tr class="hover:bg-zinc-50 transition-colors group">
                        <td class="px-6 py-5">
                            <span class="font-mono font-bold text-emerald-800">#BK-8821</span>
                        </td>
                        <td class="px-6 py-5 font-bold text-zinc-900">Nguyễn Văn An</td>
                        <td class="px-6 py-5">
                            <div class="font-medium">Sân bóng số 5</div>
                            <div class="text-[10px] uppercase text-zinc-400">Cơ sở Stadium Way</div>
                        </td>
                        <td class="px-6 py-5 font-bold text-zinc-900">18:00 - 19:30</td>
                        <td class="px-6 py-5 font-black text-primary">450.000đ</td>
                        <td class="px-6 py-5">
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">
                                <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span> Paid
                            </span>
                        </td>
                        <td class="px-6 py-5 text-right">
                            <button class="p-2 text-zinc-400 hover:text-primary transition-all"><span class="material-symbols-outlined">visibility</span></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="p-6 bg-zinc-50 border-t border-zinc-100 flex justify-between items-center">
            <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-400">Hiển thị 10 của 256 đơn</span>
            <div class="flex gap-2">
                <button class="w-10 h-10 rounded-full flex items-center justify-center bg-primary text-white font-bold">1</button>
                <button class="w-10 h-10 rounded-full flex items-center justify-center border border-zinc-200 text-zinc-600 hover:bg-white">2</button>
            </div>
        </div>
    </div>

    <!-- Secondary Insight Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-emerald-900 rounded-xl relative overflow-hidden group shadow-lg">
            <div class="relative z-10 text-white">
                <span class="text-[10px] font-bold uppercase tracking-widest text-emerald-300">Doanh thu hôm nay</span>
                <div class="text-4xl font-manrope font-extrabold mt-2">12.500.000đ</div>
            </div>
            <span class="material-symbols-outlined absolute -right-4 -bottom-4 text-emerald-800 text-9xl rotate-12 group-hover:rotate-0 transition-transform duration-500">payments</span>
        </div>
        <div class="p-6 bg-white rounded-xl shadow-sm border border-zinc-200 border-l-4 border-amber-500">
            <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-400">Lịch chờ xử lý</span>
            <div class="text-4xl font-manrope font-extrabold text-zinc-900 mt-2">14 lượt</div>
        </div>
        <div class="p-6 bg-white rounded-xl shadow-sm border border-zinc-200 border-l-4 border-emerald-500">
            <span class="text-[10px] font-bold uppercase tracking-widest text-zinc-400">Tỷ lệ lấp đầy</span>
            <div class="text-4xl font-manrope font-extrabold text-zinc-900 mt-2">85%</div>
            <div class="mt-4 w-full bg-zinc-100 h-2 rounded-full overflow-hidden">
                <div class="bg-primary h-full w-[85%] rounded-full"></div>
            </div>
        </div>
    </div>
</div>